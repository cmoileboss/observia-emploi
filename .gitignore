# Configuration de l'environnement
.env
.env.local
.env.*
!.env.example
!/backend/.env.example

# Dossiers de ressources
/[Rr]essources/
/[Rr]esources/

# Données du backend
# Conserver les dossiers dans Git grâce aux .gitkeep,
/backend/data/raw/*
!/backend/data/raw/.gitkeep

/backend/data/processed/*
!/backend/data/processed/.gitkeep

# Sécurité globale contre les fichiers volumineux
*.csv
*.json
*.xlsx
*.parquet
*.sqlite3
*.zip
*.json

# Caches Python et environnements virtuels
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/

# Journaux générés
logs/
/backend/logs/

data/

# Travail local et expériences temporaires
/backend/scratch/

# Sorties générées du matching
/backend/data/processed/matching/benchmarks/
/backend/data/processed/matching/progress.json
/backend/data/processed/matching/**/*.log

# Fichiers temporaires pytest
.pytest_cache/
.tmp_pytest*/