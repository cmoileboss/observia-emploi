[MASTER]
ignore=.pytest_cache
init-hook='import sys; from pathlib import Path; sys.path.insert(0, str(Path().resolve() / "backend"))'

[MESSAGES CONTROL]
disable=
    too-few-public-methods,
    too-many-locals,
    duplicate-code,
    inconsistent-return-statements,
    too-many-return-statements,
    not-callable,
    # Structural complexity — requires major refactoring
    too-many-branches,
    too-many-statements,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-nested-blocks,
    too-many-lines,
    too-many-instance-attributes,
    too-many-boolean-expressions,
    # sys.path manipulation pattern used by scripts
    import-error,
    import-outside-toplevel,
    wrong-import-order,
    # Script-level design choices
    broad-exception-caught,
    global-statement,
    cell-var-from-loop,
    # Dynamic attributes / internal access in scripts
    no-member,
    protected-access,
    # Style suggestions — addressed via code review
    consider-using-with,
    consider-using-get,
    consider-using-in,
    consider-iterating-dictionary,
    use-sequence-for-iteration,
    # Loop variable patterns in complex closures
    undefined-loop-variable,
    # Handled by autopep8
    superfluous-parens,
    no-else-return,
    no-else-break,
    chained-comparison,
    raise-missing-from,
    expression-not-assigned,
    pointless-statement,
    possibly-unused-variable,
    unused-argument

[FORMAT]
max-line-length=100